# Optional process-level bootstrap values.
#
# AutoReach no longer requires an environment file for application settings,
# provider credentials, or API authentication. Select the SQLite database with
# POST /v1/setup and configure integrations with PATCH /v1/settings.

# Where AutoReach may store its small database-location pointer. If omitted,
# the repository-local .data directory is used.
AUTOREACH_DATA_DIR=.data

# Optional hosting controls.
AUTOREACH_ENV=development
AUTOREACH_CORS_ORIGINS=

# Only used by the HTTP process itself; operational scheduling is configured
# and persisted through the API.
AUTOREACH_SCHEDULER_INTERVAL_SECONDS=30

# Optional. Enable the LLM tool router for natural-language operator requests.
# Keep false in simulation unless provider credentials are configured.
AUTOREACH_LLM_ORCHESTRATOR_ENABLED=false

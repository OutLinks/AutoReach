# =============================================================================
# AutoReach — environment variables (root)
# =============================================================================
# Copy to `.env` and fill in what you need:
#
#     cp .env.example .env
#
# Nothing here is required to run the SIMULATED system test
# (OrchestratorConfig.simulate = True, the default). Keys are only needed once
# you flip individual agents to live mode. Each agent also ships its own
# `.env.example` documenting just its variables.
#
# An empty / unset key disables that service: the agent's system prompt and
# pipeline adapt automatically rather than erroring.
# =============================================================================

# ── LLM provider (required for ANY live agent) ───────────────────────────────
# All five agents default to provider="anthropic", model="claude-sonnet-4-6".
ANTHROPIC_API_KEY=
# Only needed if you switch a ModelConfig.provider to "openai" / "openrouter".
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Agent 1: Lead Finder ─────────────────────────────────────────────────────
# Needs Redis running + at least one search API, or it finds nothing.
REDIS_URL=redis://localhost:6379
APOLLO_API_KEY=
PRODUCTHUNT_API_KEY=
PROXYCURL_API_KEY=
CLEARBIT_API_KEY=
HUNTER_API_KEY=

# ── Agent 2: Research Analyst ────────────────────────────────────────────────
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=
# PROXYCURL_API_KEY is shared with Agent 1 (set once above).

# ── Agent 3: Email Writer — sender identity (appears in the emails) ───────────
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_LINKEDIN_URL=
SENDER_PHONE=
# Free-text email signature block; falls back to a default if unset.
SENDER_SIGNATURE=

# ── Agent 4: Sender + Follow-Up ──────────────────────────────────────────────
# Keep simulate=true for system tests so no real email is sent.
AGENT4_SIMULATE=true
# Delivery provider: smtp | gmail | instantly | outreach
AGENT4_PROVIDER=smtp
# Display name on outgoing mail.
SENDER_FROM_NAME=AutoReach
# Optional: JSON file with a pool of sending accounts (overrides SENDER_EMAIL).
AGENT4_ACCOUNTS_FILE=

# Provider credentials — only the one matching AGENT4_PROVIDER is used,
# and only when AGENT4_SIMULATE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GMAIL_ACCESS_TOKEN=
INSTANTLY_API_KEY=
OUTREACH_ACCESS_TOKEN=

# ── Agent 5: Reply Handler ───────────────────────────────────────────────────
# Keep simulate=true for system tests so no real reply is sent.
AGENT5_SIMULATE=true
CALENDLY_LINK=https://calendly.com/autoreach/intro
# Reuses SENDER_EMAIL / SENDER_FROM_NAME above. When sending for real it uses
# the same SMTP_* / GMAIL_ACCESS_TOKEN credentials as Agent 4.

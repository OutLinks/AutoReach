# API runtime
AUTOREACH_ENV=development
AUTOREACH_API_SECRET=replace-with-a-long-random-value
AUTOREACH_DATA_DIR=.data
AUTOREACH_CORS_ORIGINS=http://localhost:3000
AUTOREACH_SCHEDULER_ENABLED=false
AUTOREACH_SCHEDULER_INTERVAL_SECONDS=30
AUTOREACH_SCHEDULER_TIMEZONE=UTC

# Safe pipeline defaults
AUTOREACH_SIMULATE=true
AUTOREACH_REPLY_HANDLING_ENABLED=false
AUTOREACH_FOLLOWUP_AFTER_DAYS=3
AUTOREACH_LEADS_PER_DAY=50
AUTOREACH_EMAILS_PER_DAY=50
AUTOREACH_FOLLOWUPS_PER_DAY=100
AUTOREACH_DAILY_SEND_LIMIT=50
AUTOREACH_HOURLY_SEND_LIMIT=10

# Live integrations (leave blank while simulating)
REDIS_URL=redis://localhost:6379
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
GOOGLE_PLACES_API_KEY=
TAVILY_API_KEY=
HUNTER_API_KEY=
ABSTRACT_API_KEY=

# Sending remains simulated unless explicitly disabled
AGENT4_PROVIDER=smtp
AGENT4_SIMULATE=true
AGENT4_REPLY_HANDOFF_ENABLED=false
AGENT4_TRACKING_BASE_URL=http://localhost:8000
AGENT5_ENABLED=false
AGENT5_SIMULATE=true
SENDER_EMAIL=
SENDER_FROM_NAME=AutoReach
AGENT4_ACCOUNTS_FILE=

# Configure the credentials for the AGENT4_PROVIDER selected above.
# Gmail / sales-engagement providers
GMAIL_ACCESS_TOKEN=
INSTANTLY_API_KEY=
OUTREACH_ACCESS_TOKEN=

# Transactional email API providers
SENDGRID_API_KEY=
# Use https://api.eu.sendgrid.com for a SendGrid EU regional subuser.
SENDGRID_API_BASE=https://api.sendgrid.com
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# Use https://api.eu.mailgun.net/v3 for an EU Mailgun account.
MAILGUN_API_BASE=https://api.mailgun.net/v3
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
RESEND_API_KEY=

# AWS SES (uses the standard AWS credential chain)
AWS_SES_REGION=

# Generic SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Agent 3: Email Writer — environment variables
#
# The SENDER_* values define the identity the emails are written from and the
# signature they close with. All are optional (sensible defaults are used).

# LLM (defaults to anthropic / claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Planned Supabase storage.
# Today Agent 3 writes to local SQLite at output/emails.db; add code wiring
# before relying on these tables in production.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_EMAILS_TABLE=emails
SUPABASE_EMAIL_JOBS_TABLE=email_jobs

# Sender identity (used in personalization + signature)
SENDER_FIRST_NAME=
SENDER_LAST_NAME=
SENDER_TITLE=
SENDER_COMPANY=
SENDER_EMAIL=
SENDER_LINKEDIN_URL=
SENDER_PHONE=
SENDER_SIGNATURE=

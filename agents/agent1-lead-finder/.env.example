# Agent 1: Lead Finder — environment variables
#
# Requires a running Redis instance (message bus between engines) and at least
# one enabled search API, otherwise no leads are produced. Unset keys disable
# that service; the system prompt and pipeline adapt automatically.

# LLM — defaults to anthropic / claude-sonnet-4-6.
# Switch providers purely via env: uncomment LLM_PROVIDER + LLM_MODEL and set
# the matching key below. e.g. for OpenRouter's owl-alpha:
#   LLM_PROVIDER=openrouter
#   LLM_MODEL=openrouter/owl-alpha
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Pipeline message bus (required)
REDIS_URL=redis://localhost:6379

# Search APIs (need >= 1)
APOLLO_API_KEY=
PRODUCTHUNT_API_KEY=

# Enrichment APIs
CLEARBIT_API_KEY=

# Email verification
HUNTER_API_KEY=

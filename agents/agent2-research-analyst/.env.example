# Agent 2: Research Analyst — environment variables
#
# Unset keys disable that collection source; the system prompt and collection
# layer adapt automatically.

# LLM (defaults to anthropic / claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Data collection sources
FIRECRAWL_API_KEY=
SERPAPI_API_KEY=

# LinkedIn scraping via PhantomBuster (replaces the shut-down Proxycurl).
# Needs the API key AND a profile-scraper phantom id to do anything. The
# company-scraper id is optional (company-page enrichment).
PHANTOMBUSTER_API_KEY=
PHANTOMBUSTER_LINKEDIN_PROFILE_AGENT_ID=
PHANTOMBUSTER_LINKEDIN_COMPANY_AGENT_ID=

# Agent 4: Sender + Follow-Up Manager — environment variables
#
# Keep AGENT4_SIMULATE=true for system tests: delivery is simulated end-to-end
# so the pipeline runs without credentials and no real email is sent.

# LLM — writes follow-up copy (defaults to anthropic / claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Planned Supabase storage.
# Today Agent 4 reads Agent 3's local SQLite DB and writes local SQLite sender
# state; add code wiring before relying on these tables in production.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_EMAILS_TABLE=emails
SUPABASE_SENT_EMAILS_TABLE=sent_emails
SUPABASE_TRACKING_EVENTS_TABLE=tracking_events
SUPABASE_SEQUENCE_STATES_TABLE=sequence_states

# Simulate delivery (no real send). Set to false to send for real.
AGENT4_SIMULATE=true

# Delivery provider: smtp | gmail | instantly | outreach
AGENT4_PROVIDER=smtp

# Sending identity
SENDER_EMAIL=
SENDER_FROM_NAME=AutoReach
# Optional JSON file with a pool of sending accounts (overrides SENDER_EMAIL).
AGENT4_ACCOUNTS_FILE=

# Provider credentials — only the one matching AGENT4_PROVIDER is used, and
# only when AGENT4_SIMULATE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GMAIL_ACCESS_TOKEN=
INSTANTLY_API_KEY=
OUTREACH_ACCESS_TOKEN=

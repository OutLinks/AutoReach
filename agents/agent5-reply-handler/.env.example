# Agent 5: Reply Handler — environment variables
#
# Keep AGENT5_SIMULATE=true for system tests: replies are drafted, persisted,
# and logged but not actually emailed.

# LLM — intent classification + reply generation (anthropic / claude-sonnet-4-6)
ANTHROPIC_API_KEY=

# Planned Supabase storage.
# Today Agent 5 writes local SQLite conversation state; add code wiring before
# relying on these tables in production.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_CONVERSATIONS_TABLE=conversations
SUPABASE_MESSAGES_TABLE=messages
SUPABASE_HANDOFFS_TABLE=handoffs
SUPABASE_NOTIFICATIONS_TABLE=notifications

# Simulate sending (no real reply email). Set to false to send for real.
AGENT5_SIMULATE=true

# Meeting-booking link sent to interested leads.
CALENDLY_LINK=https://calendly.com/autoreach/intro

# Sending identity (reused from Agent 4's config).
SENDER_EMAIL=
SENDER_FROM_NAME=AutoReach

# When sending for real (AGENT5_SIMULATE=false) it uses the same SMTP_* /
# GMAIL_ACCESS_TOKEN credentials as Agent 4.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
GMAIL_ACCESS_TOKEN=
